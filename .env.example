# Copie este arquivo para .env e preencha os segredos somente no ambiente local.
APP_NAME=Meta KPI Calculator
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
APP_TIMEZONE=America/Sao_Paulo
DEFAULT_CURRENCY=BRL
LOG_LEVEL=INFO

DEMO_MODE=true
DATABASE_URL=sqlite:///./data/meta_kpi.db
DEMO_DATABASE_URL=sqlite:///./data/meta_kpi_demo.db
SQLITE_BUSY_TIMEOUT_MS=5000

META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_API_VERSION=v26.0
META_LEAD_ACTION_TYPES=["lead","onsite_conversion.lead_grouped"]

SCHEDULER_ENABLED=false
SYNC_INTERVAL_MINUTES=60
SYNC_LOOKBACK_DAYS=7
MAX_SYNC_DAYS=31
API_BASE_URL=http://127.0.0.1:8000

