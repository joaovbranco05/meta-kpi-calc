# Copie este arquivo para .env e preencha os segredos somente no ambiente local.
APP_NAME=Meta KPI Calculator
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
APP_TIMEZONE=America/Sao_Paulo
DEFAULT_CURRENCY=BRL
LOG_LEVEL=INFO

DEMO_MODE=true
DATABASE_URL=sqlite:///./data/meta_kpi.db
DEMO_DATABASE_URL=sqlite:///./data/meta_kpi_demo.db
SQLITE_BUSY_TIMEOUT_MS=5000

META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_API_VERSION=v26.0
META_LEAD_ACTION_TYPES=["lead","onsite_conversion.lead_grouped"]

SCHEDULER_ENABLED=false
SYNC_INTERVAL_MINUTES=60
SYNC_LOOKBACK_DAYS=7
MAX_SYNC_DAYS=31
API_BASE_URL=http://127.0.0.1:8000


# Lead Ads is independent from Ads/Insights. No network or worker starts automatically.
LEAD_ADS_ENABLED=false
# Set a version verified for your app before enabling; no supported version is assumed.
# LEAD_ADS_API_VERSION=
LEAD_ADS_ACCESS_TOKEN=
LEAD_ADS_APP_SECRET=
LEAD_ADS_VERIFY_TOKEN=
LEAD_ADS_ALLOWED_PAGE_IDS=[]
# Mapping form ID -> authorized page ID, both strings.
LEAD_ADS_AUTHORIZED_SOURCES={}
LEAD_ADS_BODY_MAX_BYTES=262144
LEAD_ADS_MAX_PAGES=100
LEAD_ADS_PAGE_SIZE=100
LEAD_ADS_MAX_ATTEMPTS=5
LEAD_ADS_LEASE_SECONDS=120
LEAD_ADS_RETRY_BASE_SECONDS=30
LEAD_ADS_RETRY_MAX_SECONDS=3600
LEAD_ADS_OVERLAP_SECONDS=300
LEAD_ADS_SCAN_MAX_DAYS=31
LEAD_ADS_WORKER_BATCH_SIZE=100
LEAD_ADS_WORKER_POLL_SECONDS=5
LEAD_ADS_WORKER_BACKOFF_BASE_SECONDS=5
LEAD_ADS_WORKER_BACKOFF_MAX_SECONDS=300
