{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "API: Uvicorn",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "meta_kpi_calc.api.app:app",
        "--app-dir",
        "${workspaceFolder}/src",
        "--host",
        "127.0.0.1",
        "--port",
        "8000",
        "--reload"
      ],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}
